DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOW_ALL_ORIGINS=False

JWT_ACCESS_LIFETIME=60
JWT_REFRESH_LIFETIME=1440

TMDB_API_KEY=your_tmdb_api_key
